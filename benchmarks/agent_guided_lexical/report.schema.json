          "const": "skipped"
        },
        "retrieval_guidance_orientation_source": {
          "const": "not_applicable"
        },
        "metrics": {
          "const": null
        },
        "usage": {
          "$ref": "#/$defs/skipped_usage"
        },
        "latency_ms": {
          "const": null
        },
        "payload_bytes": {
          "const": null
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nDCG@5",
        "Recall@5",
        "MAP@5",
        "citation_precision@5",
        "negative_false_positive_rate@5"
