      "const": "llmwiki-agent-guided-lexical-benchmark-report-v1"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "agent-guided-lexical-benchmark-runner"
        },
        "version": {
          "const": "0.2.0"
        }
      }
    },
    "benchmark_class": {
      "const": "bounded-engineering-harness"
    },
    "dataset": {
      "const": "agent-guided-lexical-curated-fixture-v2"
    },
    "surface": {
      "type": "string"
    },
    "package_version": {
      "type": "string"
    },
    "implementation_revision": {
      "type": "string"
    },
    "runtime_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "platform", "python_version", "machine"],
      "properties": {
        "os": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        }
      }
    },
    "fixture": {
      "$ref": "#/$defs/fixture"
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_raw_lexical",
        "authored_agent_guided_lexical",
        "projection_raw_lexical",
        "projection_sketch_agent_guided_lexical",
        "authored_raw_hybrid",
        "projection_raw_hybrid"
      ],
      "properties": {
        "authored_raw_lexical": {
          "$ref": "#/$defs/arm"
        },
        "authored_agent_guided_lexical": {
          "$ref": "#/$defs/arm"
        },
        "projection_raw_lexical": {
          "$ref": "#/$defs/arm"
        },
        "projection_sketch_agent_guided_lexical": {
          "$ref": "#/$defs/arm"
        },
        "authored_raw_hybrid": {
          "$ref": "#/$defs/arm"
        },
        "projection_raw_hybrid": {
          "$ref": "#/$defs/arm"
        }
      }
    },
    "per_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_raw_lexical",
        "authored_agent_guided_lexical",
        "projection_raw_lexical",
        "projection_sketch_agent_guided_lexical",
        "authored_raw_hybrid",
        "projection_raw_hybrid"
      ],
      "properties": {
        "authored_raw_lexical": {
          "$ref": "#/$defs/per_query_arm"
        },
        "authored_agent_guided_lexical": {
          "$ref": "#/$defs/per_query_arm"
        },
        "projection_raw_lexical": {
          "$ref": "#/$defs/per_query_arm"
        },
        "projection_sketch_agent_guided_lexical": {
          "$ref": "#/$defs/per_query_arm"
        },
        "authored_raw_hybrid": {
          "$ref": "#/$defs/per_query_arm"
        },
        "projection_raw_hybrid": {
          "$ref": "#/$defs/per_query_arm"
        }
      }
    },
    "metric_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nDCG@5",
        "Recall@5",
        "MAP@5",
        "citation_precision@5",
        "negative_false_positive_rate@5"
      ],
      "properties": {
        "nDCG@5": {
          "$ref": "#/$defs/metric_definition"
        },
        "Recall@5": {
          "$ref": "#/$defs/metric_definition"
        },
        "MAP@5": {
          "$ref": "#/$defs/metric_definition"
        },
        "citation_precision@5": {
          "$ref": "#/$defs/metric_definition"
        },
        "negative_false_positive_rate@5": {
          "$ref": "#/$defs/metric_definition"
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "$ref": "#/$defs/authored_raw_lexical_skipped"
      },
      "then": {
        "$ref": "#/$defs/authored_raw_lexical_empty_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/authored_raw_lexical_available"
      },
      "then": {
        "$ref": "#/$defs/authored_raw_lexical_measured_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/authored_agent_guided_lexical_skipped"
      },
      "then": {
        "$ref": "#/$defs/authored_agent_guided_lexical_empty_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/authored_agent_guided_lexical_available"
      },
      "then": {
        "$ref": "#/$defs/authored_agent_guided_lexical_measured_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/projection_raw_lexical_skipped"
      },
      "then": {
        "$ref": "#/$defs/projection_raw_lexical_empty_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/projection_raw_lexical_available"
      },
      "then": {
        "$ref": "#/$defs/projection_raw_lexical_measured_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/projection_sketch_agent_guided_lexical_skipped"
      },
      "then": {
        "$ref": "#/$defs/projection_sketch_agent_guided_lexical_empty_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/projection_sketch_agent_guided_lexical_available"
      },
      "then": {
        "$ref": "#/$defs/projection_sketch_agent_guided_lexical_measured_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/authored_raw_hybrid_skipped"
      },
      "then": {
        "$ref": "#/$defs/authored_raw_hybrid_empty_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/authored_raw_hybrid_available"
      },
      "then": {
        "$ref": "#/$defs/authored_raw_hybrid_measured_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/projection_raw_hybrid_skipped"
      },
      "then": {
        "$ref": "#/$defs/projection_raw_hybrid_empty_per_query"
      }
    },
    {
      "if": {
        "$ref": "#/$defs/projection_raw_hybrid_available"
      },
      "then": {
        "$ref": "#/$defs/projection_raw_hybrid_measured_per_query"
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_sha256",
        "queries_sha256",
        "qrels_sha256",
        "agent_plan_sha256",
        "corpora",
        "query_counts",
        "qrel_counts",
        "agent_plan_row_count",
        "languages",
        "cases"
      ],
      "properties": {
        "path": {
          "const": "benchmarks/agent_guided_lexical/fixture"
        },
        "content_sha256": {
          "$ref": "#/$defs/digest"
        },
        "queries_sha256": {
          "$ref": "#/$defs/digest"
        },
        "qrels_sha256": {
          "$ref": "#/$defs/digest"
        },
        "agent_plan_sha256": {
          "$ref": "#/$defs/digest"
        },
        "corpora": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authored", "projection"],
          "properties": {
            "authored": {
              "$ref": "#/$defs/corpus"
            },
            "projection": {
              "$ref": "#/$defs/corpus"
            }
          }
        },
        "query_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "evaluated", "negative"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "evaluated": {
              "type": "integer",
              "minimum": 0
            },
            "negative": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "qrel_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "positive"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "positive": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "agent_plan_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "languages": {
          "type": "array",
          "items": {
            "enum": ["code", "en", "ko"]
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_sha256", "orientation_source_expected", "page_count"],
      "properties": {
        "path": {
          "type": "string"
        },
        "content_sha256": {
          "$ref": "#/$defs/digest"
        },
        "orientation_source_expected": {
          "enum": ["authored", "projection_extractive"]
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_calls_llm",
        "llm_call_count",
        "variants_generated_from_qrels",
        "max_query_variants",
        "source_qrels_separated",
        "original_page_citations_only",
        "public_superiority_claim",
        "raw_hybrid_requires_explicit_provider",
        "semantic_leakage_mechanically_proven",
        "release_evidence_requires_independent_source_only_plans_before_qrels",
        "fixture_is_release_evidence",
        "cold_cache_mechanically_verified",
        "service_instance_isolation_verified",
        "service_instance_isolation_method"
      ],
      "properties": {
        "runner_calls_llm": {
          "const": false
        },
        "llm_call_count": {
          "const": 0
        },
        "variants_generated_from_qrels": {
          "const": false
        },
        "max_query_variants": {
          "const": 2
        },
        "source_qrels_separated": {
          "const": true
        },
        "original_page_citations_only": {
          "const": true
        },
        "public_superiority_claim": {
          "const": false
        },
        "raw_hybrid_requires_explicit_provider": {
          "const": true
        },
        "semantic_leakage_mechanically_proven": {
          "const": false
        },
        "release_evidence_requires_independent_source_only_plans_before_qrels": {
          "const": true
        },
        "fixture_is_release_evidence": {
          "const": false
        },
        "cold_cache_mechanically_verified": {
          "const": false
        },
        "service_instance_isolation_verified": {
          "const": true
        },
        "service_instance_isolation_method": {
          "const": "factory_return_object_identity_unique_per_request"
        }
      }
    },
    "arm": {
      "oneOf": [
        {
          "$ref": "#/$defs/available_arm"
        },
        {
          "$ref": "#/$defs/skipped_arm"
        }
      ]
    },
    "available_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus",
        "status",
        "retrieval_guidance_orientation_source",
        "metrics",
        "usage",
        "latency_ms",
        "payload_bytes",
        "limitations"
      ],
      "properties": {
        "corpus": {
          "enum": ["authored", "projection"]
        },
        "status": {
          "const": "available"
        },
        "retrieval_guidance_orientation_source": {
          "enum": ["authored", "projection_extractive"]
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "usage": {
          "$ref": "#/$defs/available_usage"
        },
        "latency_ms": {
          "$ref": "#/$defs/distribution"
        },
        "payload_bytes": {
          "$ref": "#/$defs/distribution"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "skipped_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus",
        "status",
        "retrieval_guidance_orientation_source",
        "metrics",
        "usage",
        "latency_ms",
        "payload_bytes",
        "limitations"
      ],
      "properties": {
        "corpus": {
